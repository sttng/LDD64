// LDD64 — resource script (Win), made by tools/extract_rsrc.py --write-rc from the original
// LDD.exe, then given LDD64's icons and version. The cursors and the manifest are LEGO artwork:
// extract them into Resources/Win/Extracted (README.md); the project finds them there.
// Statement order = original image ids (icons 1-26, then cursors 27-42).
#include "resource.h"

LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
// LDD64: the application icon is LDD64's red brick (src/Products/LDD/Resources/ldd64.ico) in place of
// the original's icon_101.ico, the document icon likewise (ldd64_document.ico for icon_103.ico).
IDI_ICON_101 ICON "ldd64.ico"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDI_ICON_103 ICON "ldd64_document.ico"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_110 CURSOR "cursor_110.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_112 CURSOR "cursor_112.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_115 CURSOR "cursor_115.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_102 CURSOR "cursor_102.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_105 CURSOR "cursor_105.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_106 CURSOR "cursor_106.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_108 CURSOR "cursor_108.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_107 CURSOR "cursor_107.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_109 CURSOR "cursor_109.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_116 CURSOR "cursor_116.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_127 CURSOR "cursor_127.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_128 CURSOR "cursor_128.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_131 CURSOR "cursor_131.cur"
LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
IDC_CURSOR_134 CURSOR "cursor_134.cur"
LANGUAGE 0x09, 0x01   /* English (US), 1033 */
IDC_CURSOR_104 CURSOR "cursor_104.cur"
LANGUAGE 0x09, 0x01   /* English (US), 1033 */
IDC_CURSOR_133 CURSOR "cursor_133.cur"

LANGUAGE 0x06, 0x01   /* Danish (Denmark), 1030 */
// Version: LDD64's 4.64.0 (the original 4.3.11.0), the same as the Mac bundles' CFBundleVersion.
// Application::GetVersion reads FILEVERSION: it goes into saved models (Meta Application
// versionMajor / versionMinor), preferences.ini (ApplicationVersion), the About box and the
// queries to LEGO's servers.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION 4,64,0,0
 PRODUCTVERSION 4,64,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "000004b0"
        BEGIN
            VALUE "CompanyName", L"LEGO Company"
            VALUE "FileDescription", L"LEGO Digital Designer"
            VALUE "FileVersion", L"4.64.0"
            VALUE "InternalName", L"LEGO Digital Designer"
            VALUE "OriginalFilename", L"LDD64.exe"
            VALUE "ProductName", L"LEGO Digital Designer"
            VALUE "ProductVersion", L"4.64.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0, 1200
    END
END

LANGUAGE 0x09, 0x01   /* English (US), 1033 */
1 24 "LDD.exe.manifest"   /* RT_MANIFEST */
