<?xml version="1.0" encoding="UTF-8"?>
<!-- LEGO Digital Designer (Mac) - SavePanelAccessoryView (English), RECONSTRUCTED from the original
     bundle's compiled English.lproj/SavePanelAccessoryView.nib (LDD 4.3.11: same view size, frames,
     label and placeholder items). LEGOGetPathAccessoryViewOwner (LEGOGetPathAccessoryViewOwner.mm)
     loads it with itself as owner: outlet `filter` = the file-type pop-up, whose superview becomes
     the save panel's accessory view; the pop-up sends filterChanged:. -->
<document type="com.apple.InterfaceBuilder3.Cocoa.XIB" version="3.0" toolsVersion="13196" targetRuntime="MacOSX.Cocoa" propertyAccessControl="none" useAutolayout="NO">
    <dependencies>
        <deployment version="101300" identifier="macosx"/>
        <plugIn identifier="com.apple.InterfaceBuilder.CocoaPlugin" version="13196"/>
    </dependencies>
    <objects>
        <customObject id="-2" userLabel="File's Owner" customClass="LEGOGetPathAccessoryViewOwner">
            <connections>
                <outlet property="filter" destination="4" id="8"/>
            </connections>
        </customObject>
        <customObject id="-1" userLabel="First Responder" customClass="FirstResponder"/>
        <customObject id="-3" userLabel="Application" customClass="NSApplication"/>
        <customView id="1" userLabel="Accessory View">
            <rect key="frame" x="0.0" y="0.0" width="280" height="60"/>
            <autoresizingMask key="autoresizingMask" flexibleMinX="YES" flexibleMaxX="YES"/>
            <subviews>
                <textField verticalHuggingPriority="750" id="2">
                    <rect key="frame" x="17" y="23" width="86" height="17"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <textFieldCell key="cell" scrollable="YES" lineBreakMode="clipping" sendsActionOnEndEditing="YES" alignment="right" title="Format:" id="3">
                        <font key="font" metaFont="system"/>
                        <color key="textColor" name="controlTextColor" catalog="System" colorSpace="catalog"/>
                        <color key="backgroundColor" name="controlColor" catalog="System" colorSpace="catalog"/>
                    </textFieldCell>
                </textField>
                <popUpButton verticalHuggingPriority="750" id="4">
                    <rect key="frame" x="105" y="16" width="158" height="26"/>
                    <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMinY="YES"/>
                    <popUpButtonCell key="cell" type="push" title="Item 1" bezelStyle="rounded" alignment="left" lineBreakMode="truncatingTail" state="on" borderStyle="borderAndBezel" imageScaling="proportionallyDown" inset="2" selectedItem="11" id="5">
                        <behavior key="behavior" lightByBackground="YES" lightByGray="YES"/>
                        <font key="font" metaFont="menu"/>
                        <menu key="menu" title="OtherViews" id="6">
                            <items>
                                <menuItem title="Item 1" state="on" id="11"/>
                                <menuItem title="Item 2" id="12"/>
                                <menuItem title="Item 3" id="13"/>
                            </items>
                        </menu>
                    </popUpButtonCell>
                    <connections>
                        <action selector="filterChanged:" target="-2" id="7"/>
                    </connections>
                </popUpButton>
            </subviews>
        </customView>
    </objects>
</document>
